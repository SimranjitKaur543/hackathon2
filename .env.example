# Copy this file to .env and fill in your own values. .env is ignored by Git.
TELEGRAM_BOT_TOKEN=paste-your-botfather-token-here
ANTHROPIC_API_KEY=paste-your-claude-api-key-here
# Optional: your Telegram ID (send /myid to the bot) to unlock /send_all and /stats
ADMIN_TELEGRAM_ID=
# Optional: which Claude model writes the offers (default claude-opus-5-5)
CLAUDE_MODEL=
